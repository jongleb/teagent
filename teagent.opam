# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.2.0"
synopsis: "A coding agent whose unit of work is a typed program"
description:
  "The model writes a Dartea (Elm) program; teagent typechecks it, plans it, runs its effects through one handler, and logs every step so any session replays exactly. Write and edit stay staged until commit, and shell commands run in a sandboxed clone of the project."
maintainer: ["Gleb <10594395+jongleb@users.noreply.github.com>"]
authors: ["Gleb <10594395+jongleb@users.noreply.github.com>"]
license: "BSD-3-Clause"
homepage: "https://github.com/jongleb/teagent"
bug-reports: "https://github.com/jongleb/teagent/issues"
depends: [
  "ocaml" {>= "5.4.0"}
  "dune" {>= "3.10"}
  "menhir" {>= "20240715"}
  "cmdliner" {>= "2.0.0"}
  "fpath"
  "bos"
  "rresult"
  "yojson" {>= "3.0.0"}
  "conf-libcurl"
  "ocurl"
  "ezcurl"
  "lwt"
  "trace" {>= "0.12"}
  "digestif"
  "base64"
  "tar" {>= "3.0.0"}
  "tar-unix" {>= "3.0.0"}
  "decompress"
  "zipc"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "ppx_jane"
  "non_empty_list"
  "base"
  "ounit2" {with-test}
  "qcheck-core" {with-test}
  "qcheck-ounit" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jongleb/teagent.git"
